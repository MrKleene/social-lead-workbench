{
  "name": "@crm/legacy-migration",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./collection/capture-archive": {
      "types": "./dist/collection/capture-archive.d.ts",
      "source": "./src/collection/capture-archive.ts",
      "default": "./dist/collection/capture-archive.js"
    },
    "./collection/comment-checkpoint": {
      "types": "./dist/collection/comment-checkpoint.d.ts",
      "source": "./src/collection/comment-checkpoint.ts",
      "default": "./dist/collection/comment-checkpoint.js"
    },
    "./common/db": {
      "types": "./dist/common/db.d.ts",
      "source": "./src/common/db.ts",
      "default": "./dist/common/db.js"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run test",
    "export:readonly": "node scripts/export.mjs",
    "build": "prisma generate && node ../../scripts/build-module.mjs legacy-migration"
  },
  "dependencies": {
    "@crm/contracts": "0.1.0",
    "@crm/domain": "0.1.0",
    "@crm/local-runtime": "0.1.0",
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  }
}
