generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Platform {
  XHS
  DOUYIN
}
enum AccountStatus {
  UNCONNECTED
  RESTRICTED
  PAUSED
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
  refreshGrants RefreshGrant[]
  audits AuditLog[]
  inboxReceivers InboxReceiver[]
  inboxReads InboxRead[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  csrfToken String
  refreshGrantId String?
  refreshGrant RefreshGrant? @relation(fields:[refreshGrantId], references:[id], onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
  @@index([refreshGrantId])
}
model RefreshGrant {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  csrfToken String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  sessions Session[]
  tokens RefreshToken[]
  @@index([userId])
  @@index([expiresAt])
}
model RefreshToken {
  id String @id
  grantId String
  grant RefreshGrant @relation(fields:[grantId], references:[id], onDelete:Cascade)
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([grantId])
}
model LoginBucket {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
model PlatformAccount {
  inboxReceiver InboxReceiver?
  inboxMessages InboxMessage[]
  defaultCollectionConfigs CollectionConfig[] @relation("DefaultExecutionAccount")
  id String @id @default(cuid())
  platform Platform
  label String
  status AccountStatus @default(UNCONNECTED)
  isDemo Boolean @default(true)
  pauseReason String?
  ownerId String?
  dailyLimit Int @default(10)
  archivedAt DateTime?
  version Int @default(0)
  loginSessionKey String? @unique
  loginProvider String?
  loginPlatformUserId String?
  loginNickname String?
  loginVerifiedAt DateTime?
  deviceLease DeviceExecutionLease?
  sessionReference AccountSessionReference?
  logins AccountLogin[]
  @@unique([platform, loginProvider, loginPlatformUserId])
  usage AccountDay[]
  contacts ContactLedger[]
  createdAt DateTime @default(now())
}
model PlatformIdentity {
  id String @id @default(cuid())
  platform Platform
  platformUserId String
  nickname String
  isDemo Boolean @default(true)
  contactLedger ContactLedger[]
  comments SourceComment[]
  @@unique([platform, platformUserId])
}
model SourcePost {
  id String @id @default(cuid())
  platform Platform
  platformPostId String
  title String
  isDemo Boolean @default(true)
  comments SourceComment[]
  @@unique([platform, platformPostId])
}
model SourceComment {
  id String @id @default(cuid())
  platform Platform
  platformCommentId String
  postId String
  post SourcePost @relation(fields:[postId],references:[id])
  identityId String
  identity PlatformIdentity @relation(fields:[identityId],references:[id])
  parentPlatformCommentId String?
  originalText String
  observedAt DateTime @default(now())
  isDemo Boolean @default(true)
  matches SourceMatch[]
  @@unique([platform, platformCommentId])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  action String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
  @@index([entityId,createdAt])
}

enum ReplyChannel {
  COMMENT
  DM
}
model ReplyTemplate {
  id String @id @default(cuid())
  name String
  channel ReplyChannel
  body String
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  configs CollectionConfig[]
}
model CollectionConfig {
  defaultExecutionAccountId String?
  defaultExecutionAccount PlatformAccount? @relation("DefaultExecutionAccount",fields:[defaultExecutionAccountId],references:[id],onDelete:Restrict)
  @@index([defaultExecutionAccountId])
  legacyMatchingEnabled Boolean @default(false) // explicit compatibility only; pure capture by default
  semanticControl SemanticControl?
  captures CapturedPost[]
  capturedComments CapturedComment[]
  semanticCalls SemanticModelCall[]
  semanticRules Json?
  semanticReviews SemanticReview[]
  commentRules Json?
  defaultReplyTemplateId String?
  defaultReplyTemplate ReplyTemplate? @relation(fields:[defaultReplyTemplateId],references:[id],onDelete:Restrict)
  @@index([defaultReplyTemplateId])
  id String @id @default(cuid())
  name String
  platform Platform
  mode String @default("MOCK")
  keywords String[]
  excludeWords String[]
  batchLimit Int @default(3)
  enabled Boolean @default(true)
  revision Int @default(1)
  activeRunId String?
  failureCount Int @default(0)
  nextAllowedAt DateTime?
  pauseReason String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs CollectionRun[]
  monitors MonitorPost[]
  matches SourceMatch[]
}
model CollectionRun {
  captures CapturedPost[]
  capturedComments CapturedComment[]
  readPlan Json?
  capturedPosts Int @default(0)
  capturedCommentsCount Int @default(0)
  semanticReviews SemanticReview[]
  metrics Json?
  id String @id @default(cuid())
  configId String
  config CollectionConfig @relation(fields:[configId],references:[id])
  requestKey String @unique
  revision Int
  snapshot Json
  execution Json?
  scenario String
  status String @default("QUEUED")
  reason String?
  cancelRequested Boolean @default(false)
  requests Int @default(0)
  observed Int @default(0)
  matched Int @default(0)
  added Int @default(0)
  notices Int @default(0)
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  matches SourceMatch[]
  @@index([configId,createdAt])
}
model MonitorPost {
  id String @id @default(cuid())
  configId String
  config CollectionConfig @relation(fields:[configId],references:[id])
  revision Int
  platformPostId String
  baselineAt DateTime?
  coverage String @default("PARTIAL")
  lastRunId String?
  observations CommentObservation[]
  @@unique([configId,revision,platformPostId])
}
model CommentObservation {
  id String @id @default(cuid())
  monitorId String
  monitor MonitorPost @relation(fields:[monitorId],references:[id],onDelete:Cascade)
  platformCommentId String
  state String @default("PRESENT")
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  lastRunId String
  @@unique([monitorId,platformCommentId])
}
model SourceMatch {
  assessment Json?
  id String @id @default(cuid())
  configId String
  config CollectionConfig @relation(fields:[configId],references:[id])
  revision Int
  runId String
  run CollectionRun @relation(fields:[runId],references:[id])
  commentId String
  comment SourceComment @relation(fields:[commentId],references:[id],onDelete:Cascade)
  keywords String[]
  classification String
  isBaseline Boolean
  createdAt DateTime @default(now())
  @@unique([configId,revision,commentId])
}
// Shared usage by explicit mode/timezone/day; an override expires with that bucket.
model AccountDay {
  accountId String
  account PlatformAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
  day String
  occupied Int @default(0)
  dailyLimitOverride Int?
  @@id([accountId,day])
}
model ContactLedger {
  id String @id @default(cuid())
  identityId String
  mode String @default("LEGACY_SIMULATION")
  @@unique([identityId,mode])
  identity PlatformIdentity @relation(fields:[identityId],references:[id],onDelete:Restrict)
  accountId String
  account PlatformAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  attempts ContactAttempt[]
  createdAt DateTime @default(now())
}
enum ContactOutcome {
  RESERVED
  CONFIRMED
  CANCELLED
  ATTEMPTED
  UNKNOWN
  SIMULATED_SUCCESS
  FAILED
}
model ContactAttempt {
  accountIdSnapshot String?
  historySnapshot Json?
  jobId String? @unique
  mode String @default("LEGACY_SIMULATION")
  channel ReplyChannel?
  content String?
  platformReceipt String?
  attemptedAt DateTime?
  confirmedAt DateTime?
  id String @id @default(cuid())
  ledgerId String
  ledger ContactLedger @relation(fields:[ledgerId],references:[id],onDelete:Restrict)
  requestKey String @unique
  kind String
  outcome ContactOutcome @default(ATTEMPTED)
  day String
  actorId String
  resolutionNote String?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ledgerId,createdAt])
}

model AccountLogin {
  id String @id @default(uuid())
  accountId String
  account PlatformAccount @relation(fields:[accountId], references:[id], onDelete:Cascade)
  actorId String
  requestKey String @unique
  runtimeId String
  mode String
  state String @default("STARTING")
  reason String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}

// Opaque device/session references only. No platform credentials or local paths.
model AccountSessionReference {
  deviceKeyId String?
  accountId String @id
  account PlatformAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
  deviceId String
  sessionKey String @unique
  provider String
  state String @default("UNVERIFIED")
  checkedRuntimeId String?
  verifiedAt DateTime?
  checkingUntil DateTime?
  updatedAt DateTime @updatedAt
}

model ExecutionDevice {
  id String @id
  keyId String @unique
  publicKey String
  name String
  os String
  provider String
  enabled Boolean @default(true)
  credentialRoot String
  approvedBy String
  approvedAt DateTime @default(now())
  revokedAt DateTime?
  lastSeenAt DateTime?
  runtimeId String?
  version Int @default(0)
  leases DeviceExecutionLease[]
}
model DeviceExecutionLease {
  accountId String @id
  account PlatformAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
  deviceId String
  device ExecutionDevice @relation(fields:[deviceId],references:[id],onDelete:Restrict)
  token String @unique
  expiresAt DateTime
}

// Opt-in, bounded context snapshots. No model credentials or outbound messages.
model SemanticReview {
  automaticContactAllowed Boolean @default(true)
 contactJobs AutoContactJob[]
  policyId String?
  policyRevision Int?
  sourceContentHash String?
  policySnapshot CommentReviewPolicyVersion? @relation(fields:[policyId,policyRevision],references:[policyId,revision],onDelete:Restrict)
  @@index([policyId,policyRevision,sourceContentHash,selectedModel])
  analysisKey String? @unique
  selectedModel String?
  ruleHash String?
  contextVersion String?
  captureId String?
  capture CapturedComment? @relation(fields:[captureId],references:[id],onDelete:Restrict)
  evaluationInput Json?
  id String @id @default(cuid())
  configId String
  config CollectionConfig @relation(fields:[configId], references:[id], onDelete:Restrict)
  runId String
  run CollectionRun @relation(fields:[runId], references:[id], onDelete:Restrict)
  revision Int
  leaseUntil DateTime?
  snapshotHash String
  platform Platform
  platformUserId String
  snapshot Json
  rules Json
  state String @default("UNCONFIGURED")
  score Int?
  reason String?
  context String @default("INSUFFICIENT")
  result Json?
  provider String @default("NONE")
  modelVersion String?
  isDemo Boolean
  reviewStatus String @default("PENDING")
  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([configId,revision,snapshotHash])
  @@index([configId,createdAt])
  @@index([platform,platformUserId])
}

model SemanticModelCall {
 trigger String @default("MANUAL")
 configurationVersion Int?
 policyId String?
 policyRevision Int?
 policySnapshot CommentReviewPolicyVersion? @relation(fields:[policyId,policyRevision],references:[policyId,revision],onDelete:Restrict)
 id String @id @default(uuid())
 requestKey String @unique
 previewHash String
 configId String?
 config CollectionConfig? @relation(fields:[configId],references:[id],onDelete:Cascade)
 actorId String
 status String
 errorCode String?
 rows Int
 inputTokens Int?
 outputTokens Int?
 createdAt DateTime @default(now())
 finishedAt DateTime?
 reservedUntil DateTime
 @@index([createdAt])
}

model SemanticControl {
 configId String @id
 config CollectionConfig @relation(fields:[configId],references:[id],onDelete:Cascade)
 enabled Boolean @default(false)
 version Int @default(0)
 updatedAt DateTime @updatedAt
}
model CapturedPost {
 id String @id @default(cuid())
 configId String
 config CollectionConfig @relation(fields:[configId],references:[id],onDelete:Restrict)
 runId String
 run CollectionRun @relation(fields:[runId],references:[id],onDelete:Restrict)
 platformPostId String
 contentHash String
 snapshot Json
 coverage String @default("UNKNOWN")
 stopReason String?
 lastRunId String
 createdAt DateTime @default(now())
 lastSeenAt DateTime @default(now())
 comments CapturedComment[]
 @@unique([configId,platformPostId,contentHash])
}
model CapturedComment {
 id String @id @default(cuid())
 configId String
 config CollectionConfig @relation(fields:[configId],references:[id],onDelete:Restrict)
 runId String
 run CollectionRun @relation(fields:[runId],references:[id],onDelete:Restrict)
 postId String
 post CapturedPost @relation(fields:[postId],references:[id],onDelete:Restrict)
 platformCommentId String
 contentHash String
 contextVersion String
 snapshot Json
 isDemo Boolean
 lastRunId String
 createdAt DateTime @default(now())
 lastSeenAt DateTime @default(now())
 reviews SemanticReview[]
 @@unique([configId, platformCommentId, contentHash, contextVersion], map: "CapturedComment_content_version_key")
 @@index([configId,createdAt])
}

// One local provider configuration. Tombstone remains after removal; no environment fallback.
model ModelSettings {
 id String @id
 version Int @default(0)
 model String
 endpoint String @default("beijing-standard")
 dailyLimit Int? // null means no cumulative request-count cap; existing numeric limits remain
 priceVersion String
 consent Boolean @default(false)
 consentInputPolicy String?
 note String @default("")
 encryptedKey Json?
 updatedAt DateTime @updatedAt
}

// Recovery metadata only. Public IDs/fingerprints, never cookies or access URLs.
// No cascade into account or source records.
model CommentReadCheckpoint {
 id String @id @default(cuid())
 configId String
 platformPostId String
 accountId String
 deviceId String
 revision Int
 fence Int @default(0)
 ownerRunId String?
 expiresAt DateTime?
 sequence Int @default(0)
 state String @default("PARTIAL")
 checkpoint Json
 updatedAt DateTime @updatedAt
 @@unique([configId,platformPostId,accountId,deviceId])
 @@index([ownerRunId])
}

// Independent from search configuration. Revisions are immutable evidence.
model AutoReviewJob {
 id String @id @default(uuid())
 policyId String
 policy CommentReviewPolicy @relation(fields:[policyId],references:[id],onDelete:Cascade)
 policyVersion Int
 inputPolicyVersion String @default("contact-redaction-v1")
 postId String
 runId String
 status String @default("PENDING")
 reason String?
 processed Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([policyId,postId,runId])
 @@index([status,createdAt])
}
model CommentReviewPolicy {
 autoEnabled Boolean @default(false)
 autoModelVersion Int?
 autoActorId String?
 autoJobs AutoReviewJob[]
 manualJobs ManualReviewJob[]
 id String @id
 name String
 target String
 revision Int @default(1)
 version Int @default(1)
 enabled Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 revisions CommentReviewPolicyVersion[]
}
model CommentReviewPolicyVersion {
 policyId String
 revision Int
 target String
 createdAt DateTime @default(now())
 policy CommentReviewPolicy @relation(fields:[policyId],references:[id],onDelete:Restrict)
 reviews SemanticReview[]
 calls SemanticModelCall[]
 @@id([policyId,revision])
}

model ManualReviewJob {
 id String @id @default(uuid())
 policyId String
 policy CommentReviewPolicy @relation(fields:[policyId],references:[id],onDelete:Cascade)
 policyRevision Int
 modelVersion Int
 model String
 priceVersion String
 actorId String
 postId String
 title String
 coverage String
 scopeHash String
 items Json
 preview Json
 status String @default("PREVIEW")
 reason String?
 requestKey String? @unique
 batchIds String[] @default([])
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,createdAt])
 @@index([scopeHash,actorId])
}

// Independent opt-in sending rules. No migration of review consent into sending consent.
model AutoContactRule {
 channelPlans Json @default("[]")
 channels ReplyChannel[] @default([])
 templateId String?
 templateVersion Int?
 accountLimits Json @default("[]")
 model String @default("")
 id String @id @default(cuid())
 platform Platform
 policyId String
 policyRevision Int
 threshold Int @default(80)
 channel ReplyChannel @default(COMMENT)
 content String @default("")
 accountIds String[] @default([])
 enabled Boolean @default(false)
 version Int @default(1)
 authorizedBy String?
 authorizedAt DateTime?
 authorizedHash String?
 mode String @default("REAL")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 jobs AutoContactJob[]
}
model AutoContactControl {
 activeJobId String?
 leaseUntil DateTime?
 platform Platform
 mode String
 pauseReason String?
 pausedAt DateTime?
 @@id([platform,mode])
}
model AutoContactJob {
 manualRequestId String?
 availabilityVersion Int @default(0)
 sourceSnapshot Json?
 id String @id @default(uuid())
 ruleId String
 rule AutoContactRule @relation(fields:[ruleId],references:[id],onDelete:Restrict)
 ruleVersion Int
 reviewId String
 review SemanticReview @relation(fields:[reviewId],references:[id],onDelete:Restrict)
 reviewVersion Int
 mode String
 platform Platform
 recipientId String
 postId String
 commentId String
 channel ReplyChannel
 content String
 evidence Json
 eligibilityHash String
 status String @default("QUEUED")
 reason String?
 accountId String?
 attemptId String? @unique
 leaseUntil DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([ruleId,ruleVersion,reviewId,channel])
 @@index([status,createdAt])
 @@index([platform,recipientId,mode])
}

// Independent of archive versions. Absence means UNKNOWN, never NORMAL.
model PostAvailability {
 platform Platform
 postId String
 state String @default("UNKNOWN")
 reason String @default("NOT_CHECKED")
 version Int @default(1)
 checkedAt DateTime
 source String
 evidence Json
 // Latest loss of accessibility; recovery requires a new authorization and review.
 invalidatedAt DateTime?
 @@id([platform,postId])
}
model PostAvailabilityEvent {
 id String @id @default(cuid())
 platform Platform
 postId String
 version Int
 state String
 reason String
 checkedAt DateTime
 source String
 evidence Json
 actorId String?
 @@unique([platform,postId,version])
}

model AutomationPreferences {
 id String @id @default("workspace")
 version Int @default(1)
 configId String?
 policyId String?
}

// Optional finite acceptance envelope; durable total attempts, independent of daily quota.
// No cascade: closing/failed dispatch must never erase consumed authorization.
model NormalAutomationAcceptance {
 id String @id
 state String @default("ACTIVE")
 scope Json
 actorId String
 runId String? @unique
 capturedPostId String?
 modelCallId String? @unique
 reviewIds String[] @default([])
 sendJobId String? @unique
 modelClaimedAt DateTime?
 sendClaimedAt DateTime?
 createdAt DateTime @default(now())
 closedAt DateTime?
 batchPlanned Boolean @default(false)
 posts NormalAcceptancePost[]
 @@index([state])
}

model NormalAcceptancePost {
 acceptanceId String
 acceptance NormalAutomationAcceptance @relation(fields:[acceptanceId],references:[id],onDelete:Restrict)
 postId String
 modelCallId String? @unique
 reviewIds String[] @default([])
 estimatedMicros Int?
 payloadHash String?
 @@id([acceptanceId,postId])
}

// Short-lived explicit approval for exact pending replies. Never auto-renewed.
model ManualReplyRequest {
 id String @id
 actorId String
 accountId String
 accountVersion Int
 tokenHash String
 scope Json
 expiresAt DateTime
 confirmedAt DateTime?
 submissionKey String? @unique
 createdAt DateTime @default(now())
 @@index([expiresAt])
}

// Recoverable display archive. Safety tombstones persist after restoring visibility.
model HistoryArchiveBatch {
 id String @id
 actorId String
 createdAt DateTime @default(now())
 restoredAt DateTime?
 restoredBy String?
 backupSha256 String
 counts Json @default("{}")
 items HistoryArchiveItem[]
}
model HistoryArchiveItem {
 batchId String
 batch HistoryArchiveBatch @relation(fields:[batchId],references:[id],onDelete:Restrict)
 entity String
 recordId String
 previousStatus String?
 @@id([batchId,entity,recordId])
 @@index([entity,recordId],map:"HistoryArchiveItem_lookup")
}

// Receive-only inbox. Platform read status and local read status are independent.
model InboxReceiver {
  accountId String @id
  account PlatformAccount @relation(fields:[accountId], references:[id], onDelete:Cascade, onUpdate:NoAction)
  ownerId String
  owner User @relation(fields:[ownerId], references:[id], onDelete:NoAction, onUpdate:NoAction)
  generation String
  state String @default("STOPPED")
  commentMode String @default("UNCONFIRMED")
  dmMode String @default("UNCONFIRMED")
  baselineAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  lastEventAt DateTime? @db.Timestamptz(6)
  expiresAt DateTime? @db.Timestamptz(6)
  leaseToken String?
  stopRequested Boolean @default(false)
  coverage String @default("NOT_CHECKED")
  reason String?
}
model InboxMessage {
  receiverId String?
  id String @id
  accountId String
  account PlatformAccount @relation(fields:[accountId], references:[id], onDelete:Cascade, onUpdate:NoAction)
  channel String
  platformId String
  senderId String
  senderName String @default("")
  body String @default("")
  postId String?
  postTitle String?
  commentId String?
  publishedAt DateTime? @db.Timestamptz(6)
  receivedAt DateTime @default(now()) @db.Timestamptz(6)
  isNew Boolean @default(false)
  source String
  contentType String @default("TEXT")
  reads InboxRead[]
  @@unique([accountId,channel,platformId])
  @@index([receivedAt(sort:Desc),id], map:"InboxMessage_received")
}
model InboxRead {
  messageId String
  message InboxMessage @relation(fields:[messageId], references:[id], onDelete:Cascade, onUpdate:NoAction)
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade, onUpdate:NoAction)
  readAt DateTime @default(now()) @db.Timestamptz(6)
  @@id([messageId,userId])
}
