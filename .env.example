# Run npm run local:env to generate random local database credentials.
# Do not put account passwords or platform tokens here.
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:56379
APP_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false

# Read-only MCP is off by default. Do not use the original 18060 service.
# See docs/MCP-READONLY-OFFLINE-2026-10-20.md before any authorized real test.
XHS_MCP_ENABLED=0
XHS_MCP_PROFILE=
XHS_MCP_ENDPOINT=
