generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  SALES
}
enum Platform {
  XHS
  DOUYIN
}
enum LeadStatus {
  PENDING_REVIEW
  FOLLOWING
  CLOSED
}
enum ContactStage {
  MATCHED
  TO_CONTACT
  CONTACTED
  INTERESTED
  IGNORED
}
enum TaskStatus {
  PENDING
  DONE
  PAUSED
}
enum AccountStatus {
  UNCONNECTED
  RESTRICTED
  PAUSED
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(SALES)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
  leads Lead[]
  followups FollowUp[]
  audits AuditLog[]
  noticeReads NoticeRead[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model LoginBucket {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
model PlatformAccount {
  defaultCollectionConfigs CollectionConfig[] @relation("DefaultExecutionAccount")
  id String @id @default(cuid())
  platform Platform
  label String
  status AccountStatus @default(UNCONNECTED)
  isDemo Boolean @default(true)
  pauseReason String?
  ownerId String?
  dailyLimit Int @default(10)
  archivedAt DateTime?
  version Int @default(0)
  loginSessionKey String? @unique
  loginProvider String?
  loginPlatformUserId String?
  loginNickname String?
  loginVerifiedAt DateTime?
  deviceLease DeviceExecutionLease?
  sessionReference AccountSessionReference?
  logins AccountLogin[]
  @@unique([platform, loginProvider, loginPlatformUserId])
  usage AccountDay[]
  contacts ContactLedger[]
  createdAt DateTime @default(now())
}
model PlatformIdentity {
  id String @id @default(cuid())
  platform Platform
  platformUserId String
  nickname String
  isDemo Boolean @default(true)
  lead Lead?
  contactLedger ContactLedger?
  comments SourceComment[]
  @@unique([platform, platformUserId])
}
model SourcePost {
  id String @id @default(cuid())
  platform Platform
  platformPostId String
  title String
  isDemo Boolean @default(true)
  comments SourceComment[]
  @@unique([platform, platformPostId])
}
model SourceComment {
  id String @id @default(cuid())
  platform Platform
  platformCommentId String
  postId String
  post SourcePost @relation(fields:[postId],references:[id])
  identityId String
  identity PlatformIdentity @relation(fields:[identityId],references:[id])
  parentPlatformCommentId String?
  originalText String
  observedAt DateTime @default(now())
  isDemo Boolean @default(true)
  matches SourceMatch[]
  notice CollectionNotice?
  @@unique([platform, platformCommentId])
}
model Lead {
  id String @id @default(cuid())
  identityId String @unique
  identity PlatformIdentity @relation(fields:[identityId],references:[id])
  summary String
  evidence String
  status LeadStatus @default(PENDING_REVIEW)
  contactStage ContactStage @default(MATCHED)
  doNotContact Boolean @default(false)
  contactNote String?
  contactedAt DateTime?
  ownerId String?
  owner User? @relation(fields:[ownerId],references:[id])
  reviewedAt DateTime?
  reviewNote String?
  nextFollowUpAt DateTime?
  isDemo Boolean @default(true)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  followups FollowUp[]
  tasks Task[]
  notices CollectionNotice[]
  @@index([ownerId,status,nextFollowUpAt])
}
model FollowUp {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id])
  authorId String
  author User @relation(fields:[authorId],references:[id])
  content String
  nextFollowUpAt DateTime?
  createdAt DateTime @default(now())
  @@index([leadId,createdAt])
}
model Task {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id])
  title String
  kind String @default("HUMAN_REVIEW")
  status TaskStatus @default(PENDING)
  dueAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([leadId,status])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  action String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
  @@index([entityId,createdAt])
}

enum ReplyChannel {
  COMMENT
  DM
}
model ReplyTemplate {
  id String @id @default(cuid())
  name String
  channel ReplyChannel
  body String
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  configs CollectionConfig[]
}
model CollectionConfig {
  defaultExecutionAccountId String?
  defaultExecutionAccount PlatformAccount? @relation("DefaultExecutionAccount",fields:[defaultExecutionAccountId],references:[id],onDelete:Restrict)
  @@index([defaultExecutionAccountId])
  legacyMatchingEnabled Boolean @default(false) // explicit compatibility only; pure capture by default
  semanticControl SemanticControl?
  captures CapturedPost[]
  capturedComments CapturedComment[]
  semanticCalls SemanticModelCall[]
  semanticRules Json?
  semanticReviews SemanticReview[]
  commentRules Json?
  defaultReplyTemplateId String?
  defaultReplyTemplate ReplyTemplate? @relation(fields:[defaultReplyTemplateId],references:[id],onDelete:Restrict)
  @@index([defaultReplyTemplateId])
  id String @id @default(cuid())
  name String
  platform Platform
  mode String @default("MOCK")
  keywords String[]
  excludeWords String[]
  batchLimit Int @default(3)
  enabled Boolean @default(true)
  revision Int @default(1)
  activeRunId String?
  failureCount Int @default(0)
  nextAllowedAt DateTime?
  pauseReason String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs CollectionRun[]
  monitors MonitorPost[]
  matches SourceMatch[]
}
model CollectionRun {
  captures CapturedPost[]
  capturedComments CapturedComment[]
  readPlan Json?
  capturedPosts Int @default(0)
  capturedCommentsCount Int @default(0)
  semanticReviews SemanticReview[]
  metrics Json?
  id String @id @default(cuid())
  configId String
  config CollectionConfig @relation(fields:[configId],references:[id])
  requestKey String @unique
  revision Int
  snapshot Json
  execution Json?
  scenario String
  status String @default("QUEUED")
  reason String?
  cancelRequested Boolean @default(false)
  requests Int @default(0)
  observed Int @default(0)
  matched Int @default(0)
  added Int @default(0)
  notices Int @default(0)
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  matches SourceMatch[]
  @@index([configId,createdAt])
}
model MonitorPost {
  id String @id @default(cuid())
  configId String
  config CollectionConfig @relation(fields:[configId],references:[id])
  revision Int
  platformPostId String
  baselineAt DateTime?
  coverage String @default("PARTIAL")
  lastRunId String?
  observations CommentObservation[]
  @@unique([configId,revision,platformPostId])
}
model CommentObservation {
  id String @id @default(cuid())
  monitorId String
  monitor MonitorPost @relation(fields:[monitorId],references:[id],onDelete:Cascade)
  platformCommentId String
  state String @default("PRESENT")
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  lastRunId String
  @@unique([monitorId,platformCommentId])
}
model SourceMatch {
  assessment Json?
  id String @id @default(cuid())
  configId String
  config CollectionConfig @relation(fields:[configId],references:[id])
  revision Int
  runId String
  run CollectionRun @relation(fields:[runId],references:[id])
  commentId String
  comment SourceComment @relation(fields:[commentId],references:[id],onDelete:Cascade)
  keywords String[]
  classification String
  isBaseline Boolean
  createdAt DateTime @default(now())
  @@unique([configId,revision,commentId])
}
model CollectionNotice {
  id String @id @default(cuid())
  commentId String @unique
  comment SourceComment @relation(fields:[commentId],references:[id],onDelete:Cascade)
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  title String
  createdAt DateTime @default(now())
  reads NoticeRead[]
  @@index([leadId,createdAt])
}
model NoticeRead {
  noticeId String
  notice CollectionNotice @relation(fields:[noticeId],references:[id],onDelete:Cascade)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  readAt DateTime @default(now())
  @@id([noticeId,userId])
}

// Simulation only. No platform credentials, login sessions or outbound message bodies.
model AccountDay {
  accountId String
  account PlatformAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
  day String
  occupied Int @default(0)
  @@id([accountId,day])
}
model ContactLedger {
  id String @id @default(cuid())
  identityId String @unique
  identity PlatformIdentity @relation(fields:[identityId],references:[id],onDelete:Cascade)
  accountId String
  account PlatformAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  attempts ContactAttempt[]
  createdAt DateTime @default(now())
}
enum ContactOutcome {
  ATTEMPTED
  UNKNOWN
  SIMULATED_SUCCESS
  FAILED
}
model ContactAttempt {
  id String @id @default(cuid())
  ledgerId String
  ledger ContactLedger @relation(fields:[ledgerId],references:[id],onDelete:Cascade)
  requestKey String @unique
  kind String
  outcome ContactOutcome @default(ATTEMPTED)
  day String
  actorId String
  resolutionNote String?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ledgerId,createdAt])
}

model AccountLogin {
  id String @id @default(uuid())
  accountId String
  account PlatformAccount @relation(fields:[accountId], references:[id], onDelete:Cascade)
  actorId String
  requestKey String @unique
  runtimeId String
  mode String
  state String @default("STARTING")
  reason String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}

// Opaque device/session references only. No platform credentials or local paths.
model AccountSessionReference {
  deviceKeyId String?
  accountId String @id
  account PlatformAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
  deviceId String
  sessionKey String @unique
  provider String
  state String @default("UNVERIFIED")
  checkedRuntimeId String?
  verifiedAt DateTime?
  checkingUntil DateTime?
  updatedAt DateTime @updatedAt
}

model ExecutionDevice {
  id String @id
  keyId String @unique
  publicKey String
  name String
  os String
  provider String
  enabled Boolean @default(true)
  credentialRoot String
  approvedBy String
  approvedAt DateTime @default(now())
  revokedAt DateTime?
  lastSeenAt DateTime?
  runtimeId String?
  version Int @default(0)
  leases DeviceExecutionLease[]
}
model DeviceExecutionLease {
  accountId String @id
  account PlatformAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
  deviceId String
  device ExecutionDevice @relation(fields:[deviceId],references:[id],onDelete:Restrict)
  token String @unique
  expiresAt DateTime
}

// Opt-in, bounded context snapshots. No model credentials or outbound messages.
model SemanticReview {
  policyId String?
  policyRevision Int?
  sourceContentHash String?
  policySnapshot CommentReviewPolicyVersion? @relation(fields:[policyId,policyRevision],references:[policyId,revision],onDelete:Restrict)
  @@index([policyId,policyRevision,sourceContentHash,selectedModel])
  analysisKey String? @unique
  selectedModel String?
  ruleHash String?
  contextVersion String?
  captureId String?
  capture CapturedComment? @relation(fields:[captureId],references:[id],onDelete:SetNull)
  evaluationInput Json?
  id String @id @default(cuid())
  configId String
  config CollectionConfig @relation(fields:[configId], references:[id], onDelete:Cascade)
  runId String
  run CollectionRun @relation(fields:[runId], references:[id], onDelete:Cascade)
  revision Int
  leaseUntil DateTime?
  snapshotHash String
  platform Platform
  platformUserId String
  snapshot Json
  rules Json
  state String @default("UNCONFIGURED")
  score Int?
  reason String?
  context String @default("INSUFFICIENT")
  result Json?
  provider String @default("NONE")
  modelVersion String?
  isDemo Boolean
  reviewStatus String @default("PENDING")
  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([configId,revision,snapshotHash])
  @@index([configId,createdAt])
  @@index([platform,platformUserId])
}

model SemanticModelCall {
 trigger String @default("MANUAL")
 configurationVersion Int?
 policyId String?
 policyRevision Int?
 policySnapshot CommentReviewPolicyVersion? @relation(fields:[policyId,policyRevision],references:[policyId,revision],onDelete:Restrict)
 id String @id @default(uuid())
 requestKey String @unique
 previewHash String
 configId String?
 config CollectionConfig? @relation(fields:[configId],references:[id],onDelete:Cascade)
 actorId String
 status String
 errorCode String?
 rows Int
 inputTokens Int?
 outputTokens Int?
 createdAt DateTime @default(now())
 finishedAt DateTime?
 reservedUntil DateTime
 @@index([createdAt])
}

model SemanticControl {
 configId String @id
 config CollectionConfig @relation(fields:[configId],references:[id],onDelete:Cascade)
 enabled Boolean @default(false)
 version Int @default(0)
 updatedAt DateTime @updatedAt
}
model CapturedPost {
 id String @id @default(cuid())
 configId String
 config CollectionConfig @relation(fields:[configId],references:[id],onDelete:Cascade)
 runId String
 run CollectionRun @relation(fields:[runId],references:[id],onDelete:Cascade)
 platformPostId String
 contentHash String
 snapshot Json
 coverage String @default("UNKNOWN")
 stopReason String?
 lastRunId String
 createdAt DateTime @default(now())
 lastSeenAt DateTime @default(now())
 comments CapturedComment[]
 @@unique([configId,platformPostId,contentHash])
}
model CapturedComment {
 id String @id @default(cuid())
 configId String
 config CollectionConfig @relation(fields:[configId],references:[id],onDelete:Cascade)
 runId String
 run CollectionRun @relation(fields:[runId],references:[id],onDelete:Cascade)
 postId String
 post CapturedPost @relation(fields:[postId],references:[id],onDelete:Cascade)
 platformCommentId String
 contentHash String
 contextVersion String
 snapshot Json
 isDemo Boolean
 lastRunId String
 createdAt DateTime @default(now())
 lastSeenAt DateTime @default(now())
 reviews SemanticReview[]
 @@unique([configId, platformCommentId, contentHash, contextVersion], map: "CapturedComment_content_version_key")
 @@index([configId,createdAt])
}

// One local provider configuration. Tombstone remains after removal; no environment fallback.
model ModelSettings {
 id String @id
 version Int @default(0)
 model String
 endpoint String @default("beijing-standard")
 dailyLimit Int? // null means no cumulative request-count cap; existing numeric limits remain
 priceVersion String
 consent Boolean @default(false)
 note String @default("")
 encryptedKey Json?
 updatedAt DateTime @updatedAt
}

// Recovery metadata only. Public IDs/fingerprints, never cookies or access URLs.
// No cascade into account, CRM, or source records.
model CommentReadCheckpoint {
 id String @id @default(cuid())
 configId String
 platformPostId String
 accountId String
 deviceId String
 revision Int
 fence Int @default(0)
 ownerRunId String?
 expiresAt DateTime?
 sequence Int @default(0)
 state String @default("PARTIAL")
 checkpoint Json
 updatedAt DateTime @updatedAt
 @@unique([configId,platformPostId,accountId,deviceId])
 @@index([ownerRunId])
}

// Independent from search configuration. Revisions are immutable evidence.
model AutoReviewJob {
 id String @id @default(uuid())
 policyId String
 policy CommentReviewPolicy @relation(fields:[policyId],references:[id],onDelete:Cascade)
 policyVersion Int
 postId String
 runId String
 status String @default("PENDING")
 reason String?
 processed Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([policyId,postId,runId])
 @@index([status,createdAt])
}
model CommentReviewPolicy {
 autoEnabled Boolean @default(false)
 autoModelVersion Int?
 autoActorId String?
 autoJobs AutoReviewJob[]
 id String @id
 name String
 target String
 revision Int @default(1)
 version Int @default(1)
 enabled Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 revisions CommentReviewPolicyVersion[]
}
model CommentReviewPolicyVersion {
 policyId String
 revision Int
 target String
 createdAt DateTime @default(now())
 policy CommentReviewPolicy @relation(fields:[policyId],references:[id],onDelete:Restrict)
 reviews SemanticReview[]
 calls SemanticModelCall[]
 @@id([policyId,revision])
}
