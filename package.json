{
  "name": "lead-workbench",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @crm/contracts && npm run build -w @crm/api && npm run build -w @crm/web && npm run build -w @crm/worker && npm run build -w @crm/agent",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @crm/api && npm run test -w @crm/agent && npm run test:workbench && node --test scripts/test-coverage-end-signal.mjs && node --test scripts/test-persistent-model-wiring.mjs",
    "test:integration": "node scripts/test-db.mjs",
    "dev": "node scripts/workbench.mjs dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "admin:init": "tsx scripts/init-user.ts admin",
    "user:create": "tsx scripts/init-user.ts sales",
    "local:env": "node scripts/local-env.mjs",
    "pretest": "npm run build -w @crm/contracts",
    "pretypecheck": "npm run build -w @crm/contracts",
    "test:worker": "npm run build -w @crm/contracts && npm run build -w @crm/worker && node scripts/test-worker.mjs",
    "agent:check": "npm run build -w @crm/contracts && npm run check -w @crm/agent",
    "dev:collector": "DOTENV_CONFIG_PATH=.env tsx --tsconfig apps/api/tsconfig.json apps/api/src/collection/worker.ts",
    "test:queue": "node scripts/test-queue-isolated.mjs",
    "dev:mock:isolated": "node scripts/dev-mock-isolated.mjs",
    "test:aurora:ui": "npm run build -w @crm/web && node scripts/test-aurora-workspace-ui.mjs",
    "test:automation-settings:ui": "npm run build -w @crm/web && node scripts/test-automation-settings-ui.mjs",
    "test:settings-toggle:ui": "npm run build -w @crm/web && node scripts/test-settings-toggle-ui.mjs",
    "test:workbench": "vitest run apps/web/src/features/work/run-selection.test.ts apps/web/src/features/work/dashboard-model.test.ts apps/web/src/features/work/journey-progress.test.ts apps/web/src/features/accounts/login-availability.test.ts apps/web/src/features/accounts/account-status.test.ts apps/web/src/features/work/motion-policy.test.ts apps/web/src/features/work/navigation-policy.test.ts apps/web/src/features/collection/mode.test.ts apps/web/src/features/collection/saved-post-review-notice.test.ts apps/web/src/features/collection/run-stats.test.ts apps/web/src/features/work/collection-preflight.test.ts apps/web/src/features/work/collection-progress.test.ts apps/web/src/features/collection/collection-info-model.test.ts apps/web/src/features/collection/post-counts.test.ts apps/web/src/features/collection/coverage-reading-summary.test.ts apps/web/src/features/collection/coverage-progress-summary.test.ts apps/web/src/features/collection/comment-stream.test.ts apps/web/src/features/collection/collection-outcome.test.ts apps/web/src/lib/api.test.ts apps/web/src/features/work/settings-request.test.ts apps/web/src/features/auto-contact/account-ready.test.ts apps/web/src/features/inbox/inbox.test.ts",
    "test:mcp": "node scripts/test-queue-isolated.mjs --mcp",
    "test:mock:isolated": "node scripts/test-queue-isolated.mjs --mock-only",
    "dev:mcp:offline": "node scripts/dev-mock-isolated.mjs --mcp-fixture",
    "test:real:preflight": "node --test scripts/real-mcp/core.test.mjs",
    "test:real:offline": "node --import tsx scripts/test-real-mcp-offline.mjs",
    "test:xhs:entry:offline": "npm run build -w @crm/web && node scripts/test-account-entry-offline.mjs",
    "test:accounts-clarity:ui": "npm run build -w @crm/web && node scripts/test-account-clarity-ui.mjs",
    "test:xhs:login:browser": "node scripts/test-account-login-browser.mjs",
    "dev:persistent": "node scripts/dev-persistent.mjs",
    "dev:persistent:offline": "node scripts/dev-persistent.mjs --offline",
    "test:device:vault": "node scripts/build-device-vault.mjs && node scripts/test-device-vault.mjs",
    "test:persistent": "node scripts/test-persistent-restart.mjs",
    "test:platform": "node --test runtime/platform.test.cjs",
    "test:windows:native": "node scripts/build-windows-host.mjs && node scripts/test-windows-native.mjs",
    "test:persistent:lock": "node --test scripts/persistent-lock.test.mjs",
    "test:persistent:diagnostics": "node --test scripts/persistent-diagnostics.test.mjs",
    "test:comment-review:integration": "node scripts/test-independent-review.mjs",
    "test:comment-review:ui": "npm run build -w @crm/web && node scripts/test-independent-review-ui.mjs",
    "test:comment-rules:ui": "npm run build -w @crm/web && node scripts/test-comment-rules-ui.mjs",
    "test:semantic:ui": "npm run build -w @crm/web && node scripts/test-semantic-review-ui.mjs",
    "dev:persistent:background": "node scripts/dev-persistent-background.mjs",
    "test:persistent:background": "node --test scripts/persistent-background.test.mjs",
    "dev:persistent:backend": "node scripts/dev-persistent.mjs --backend",
    "dev:persistent:web": "node scripts/dev-persistent-web.mjs",
    "test:persistent:supervision": "node --test scripts/persistent-supervision.test.mjs",
    "model:vault:init": "node scripts/init-model-vault.mjs",
    "test:model-settings:ui": "npm run build -w @crm/web && node scripts/test-model-settings-ui.mjs",
    "dev:legacy": "concurrently -n api,web 'npm run dev -w @crm/api' 'npm run dev -w @crm/web'",
    "start": "node scripts/workbench.mjs start",
    "stop": "node scripts/workbench.mjs stop",
    "restart": "node scripts/workbench.mjs restart",
    "status": "node scripts/workbench.mjs status",
    "test:commands": "node scripts/test-workbench-commands.mjs",
    "test:navigation:ui": "npm run build -w @crm/web && node scripts/test-app-navigation-ui.mjs",
    "test:orbit:ui": "npm run build -w @crm/web && node scripts/test-orbit-collection-ui.mjs",
    "test:collection-task:ui": "npm run build -w @crm/web && node scripts/test-collection-task-ui.mjs",
    "test:comment-stream:ui": "npm run build -w @crm/web && node --import tsx scripts/test-comment-stream-ui.mjs",
    "test:collection-info:ui": "npm run build -w @crm/web && node --import tsx scripts/test-collection-info-ui.mjs",
    "test:saved-post:ui": "npm run build -w @crm/web && node scripts/test-saved-post-read-ui.mjs",
    "test:session-preflight:ui": "npm run build -w @crm/web && node scripts/test-session-preflight-ui.mjs",
    "test:post-availability:ui": "npm run build -w @crm/web && node scripts/test-post-availability-ui.mjs",
    "test:auto-contact:ui": "npm run build -w @crm/web && node scripts/test-auto-contact-ui.mjs",
    "test:auth": "node scripts/test-remember-login.mjs",
    "build:inbox": "node scripts/inbox/build.mjs",
    "desktop:build": "npm run build -w @crm/contracts && npm run typecheck -w @crm/web && npm exec --workspace @crm/web -- vite build --config vite.desktop.config.ts",
    "desktop:test": "npm run local:test && node --test apps/desktop/test/*.test.cjs",
    "desktop:start": "electron apps/desktop/src/main.cjs",
    "desktop:release-check": "node scripts/desktop/release-check.mjs",
    "desktop:package:preview": "npm run desktop:build && node scripts/build-windows-host.mjs && npm run desktop:stage && electron-builder --config apps/desktop/electron-builder.cjs --dir",
    "desktop:package:win": "npm run desktop:release-check && npm run desktop:build && node scripts/build-windows-host.mjs && npm run desktop:stage && electron-builder --config apps/desktop/electron-builder.cjs --win nsis --x64",
    "desktop:stage": "node scripts/desktop/stage.mjs",
    "desktop:test:ui": "npm run desktop:build && node scripts/desktop/test-ui.cjs",
    "local:test": "node --test tests/local/*.test.cjs",
    "local:import:offline": "node scripts/local/import-offline.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.65.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.9.0",
    "@prisma/client": "6.19.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  }
}
